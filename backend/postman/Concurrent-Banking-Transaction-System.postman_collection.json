    {
      "name": "Transactions",
      "item": [
        {
          "name": "Deposit to Account 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"deposit\",\n  \"amount\": 200,\n  \"accountId\": \"{{accountId1}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"]
            },
            "description": "Creates a deposit transaction."
          },
          "response": []
        },
        {
          "name": "Withdraw from Account 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"withdraw\",\n  \"amount\": 150,\n  \"accountId\": \"{{accountId1}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"]
            },
            "description": "Creates a withdrawal transaction."
          },
          "response": []
        },
        {
          "name": "Transfer Account 1 -> Account 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"transfer\",\n  \"amount\": 100,\n  \"fromAccountId\": \"{{accountId1}}\",\n  \"toAccountId\": \"{{accountId2}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"]
            },
            "description": "Transfers funds between accounts."
          },
          "response": []
        },
        {
          "name": "Failed Withdraw (Insufficient Balance)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"withdraw\",\n  \"amount\": 999999,\n  \"accountId\": \"{{accountId1}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"]
            },
            "description": "Negative test for insufficient balance and transaction:failed socket event."
          },
          "response": []
